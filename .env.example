# ============================================================
# LuxyHub Environment Configuration
#
# Production Architecture
#
# Runtime State
#   • Rate Limiter → Valkey
#   • Delivery Session → Valkey
#
# Persistent Data
#   • PostgreSQL
#
# During staged rollout:
#   postgres
#   shadow
#   valkey_canary
#   valkey
# ============================================================

# ============================================================
# Application
# ============================================================

# Public site URL for CORS trust checks (optional)
NEXT_PUBLIC_SITE_URL=

# ============================================================
# Supabase
# ============================================================

# Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe for frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (SERVER ONLY — bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Security
# ============================================================

# Delivery payload encryption secret
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset
# Recommended for production secret separation
DELIVERY_PAYLOAD_SECRET=

# Non-secret key ID for payload encryption generation tracking (optional)
DELIVERY_PAYLOAD_KEY_ID=

# Internal cron endpoint bearer token
CRON_SECRET=

# Internal admin API bearer token
# Used only for admin-bearer private raw script reads
# Must be different from CRON_SECRET
ADMIN_API_KEY=

# Analytics hashing pepper
# Protects hashed IP/user-agent/email-derived buckets from precomputation
ANALYTICS_PEPPER=

# Discord webhook URL for internal alert notifications (optional)
INTERNAL_ALERT_DISCORD_WEBHOOK=

# GitHub Actions event worker target URL (required for production event processing)
# Stored as GitHub Actions secret, not in Vercel environment
EVENT_WORKER_URL=

# ============================================================
# Cloudflare Turnstile
# ============================================================

# Public site key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side verification secret
TURNSTILE_SECRET_KEY=

# ============================================================
# Valkey
# ============================================================

# Enable Valkey integration
VALKEY_ENABLED=false

# Connection host (required when VALKEY_ENABLED=true)
VALKEY_HOST=

# Connection port
# Default: 6379
VALKEY_PORT=6379

# Database number (0-15)
# Default: 0
VALKEY_DB=0

# TLS enabled
# Default: false
VALKEY_TLS=false

# Optional password
VALKEY_PASSWORD=

# Connect timeout in milliseconds (1-30000)
# Default: 1000
VALKEY_CONNECT_TIMEOUT_MS=1000

# Command timeout in milliseconds (1-30000)
# Default: 1000
VALKEY_COMMAND_TIMEOUT_MS=1000

# ============================================================
# Rate Limiter
# ============================================================

# Runtime mode
#   postgres        – PostgreSQL authoritative
#   shadow          – PostgreSQL authoritative + Valkey shadow comparison
#   valkey_canary   – Deterministic percentage rollout to Valkey
#   valkey          – Valkey authoritative (Production)
# Default: postgres
RATE_LIMIT_MODE=postgres

# Canary percentage (0-100)
# Only used when RATE_LIMIT_MODE=valkey_canary
# Default: 0
RATE_LIMIT_CANARY_PERCENT=0

# ============================================================
# Delivery Session
# ============================================================

# Runtime mode
#   postgres        – PostgreSQL authoritative
#   shadow          – PostgreSQL authoritative + Valkey shadow comparison
#   valkey_canary   – Deterministic percentage rollout to Valkey
#   valkey          – Valkey authoritative (Production)
# Default: postgres
DELIVERY_SESSION_MODE=postgres

# Canary percentage (0-100)
# Only used when DELIVERY_SESSION_MODE=valkey_canary
# Default: 0
DELIVERY_SESSION_CANARY_PERCENT=0

# Session TTL in seconds (1-3600)
# Default: 60
DELIVERY_SESSION_TTL_SECONDS=60

# Enable trace diagnostics
#   true  – Enable during rollout, debugging, or production monitoring
#   false – Long-term stable production
# Default: false
DELIVERY_SESSION_TRACE=false

# ============================================================
# Monitoring
# ============================================================

# Operational monitoring bearer token
# Used for /api/internal/rate-limit-shadow and /api/internal/delivery-session
LUXY_MONITOR_TOKEN=
